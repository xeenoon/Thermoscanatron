{
  "name": "test-thermal-stream",
  "version": "1.0.0",
  "private": true,
  "description": "MLX90640 temperature stream viewer for the QT Py ESP32-S3 firmware",
  "type": "module",
  "scripts": {
    "build-native": "cmake -S native -B native/build && cmake --build native/build",
    "prestart": "npm run build-native",
    "start": "node src/server.js",
    "simulate": "node src/server.js --simulate",
    "list-ports": "node src/server.js --list",
    "test": "node --test",
    "validate": "node scripts/validate.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
